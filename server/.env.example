PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/proplink?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# Cloudinary — required for listing photo uploads (POST /api/uploads/listing-images).
# All three must be set; if any is missing the upload endpoint returns 503 with a
# clear message instead of pretending the upload worked. Server-side only —
# these values are never exposed to the browser.
# Limits enforced in server/middleware/upload.js: 5 MB per image, 10 images per
# request, JPEG/PNG/WebP/GIF only. Uploads land in the folder proplink/listings.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
